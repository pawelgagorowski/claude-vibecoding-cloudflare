{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The Worker name is part of every link: https://<name>.<account-subdomain>.workers.dev
  // Branch previews add the branch in front: https://<branch>-<name>.<account-subdomain>.workers.dev
  "name": "claude-vibecoding-cloudflare",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "workers_dev": true,
  "preview_urls": true
}
